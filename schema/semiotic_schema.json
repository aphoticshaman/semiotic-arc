{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Semiotic ARC Annotation",
  "description": "Schema for annotating ARC tasks with cognitive primitives",
  "type": "object",
  "required": ["task_id", "perception", "reasoning", "transformation"],
  "properties": {
    "task_id": {
      "type": "string",
      "description": "Unique identifier for the ARC task"
    },
    "perception": {
      "type": "object",
      "description": "Layer 1-5: What the human eye sees",
      "properties": {
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "color": {"type": "integer", "minimum": 0, "maximum": 9},
              "shape": {
                "type": "string",
                "enum": ["point", "line", "rectangle", "square", "L-shape", "T-shape", "cross", "diagonal", "irregular", "composite"]
              },
              "size": {"type": "integer", "description": "Pixel count"},
              "position": {
                "type": "object",
                "properties": {
                  "centroid": {"type": "array", "items": {"type": "integer"}},
                  "bbox": {"type": "array", "items": {"type": "integer"}, "description": "[x1, y1, x2, y2]"}
                }
              },
              "semantic_role": {
                "type": "string",
                "enum": ["agent", "target", "obstacle", "boundary", "marker", "background", "path", "container", "contained"]
              }
            }
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subject": {"type": "string", "description": "Object ID"},
              "predicate": {
                "type": "string",
                "enum": ["above", "below", "left_of", "right_of", "inside", "contains", "adjacent", "aligned_h", "aligned_v", "same_color", "same_shape", "touching", "separated"]
              },
              "object": {"type": "string", "description": "Object ID"}
            }
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "members": {"type": "array", "items": {"type": "string"}},
              "grouping_criterion": {
                "type": "string",
                "enum": ["color", "shape", "proximity", "alignment", "pattern", "size"]
              }
            }
          }
        }
      }
    },
    "patterns": {
      "type": "object",
      "description": "Layer 6-7: Detected regularities",
      "properties": {
        "symmetry": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {"type": "string", "enum": ["horizontal", "vertical", "rotational_90", "rotational_180", "diagonal"]},
              "axis": {"type": "array", "items": {"type": "integer"}},
              "objects": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "repetition": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "motif": {"type": "string", "description": "Object or group ID"},
              "count": {"type": "integer"},
              "direction": {"type": "string", "enum": ["horizontal", "vertical", "diagonal", "radial"]}
            }
          }
        },
        "sequence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "elements": {"type": "array", "items": {"type": "string"}},
              "progression": {"type": "string", "enum": ["size_increase", "size_decrease", "color_gradient", "position_shift", "rotation"]}
            }
          }
        }
      }
    },
    "transformation": {
      "type": "object",
      "description": "Layer 8-9: What changes between input and output",
      "properties": {
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["move", "copy", "delete", "create", "resize", "recolor", "rotate", "reflect", "fill", "extend", "crop", "complete_pattern", "apply_mask", "conditional"]
              },
              "subject": {"type": "string", "description": "Object or group ID"},
              "parameters": {"type": "object"},
              "condition": {"type": "string", "description": "When this operation applies"}
            }
          }
        },
        "rule_natural_language": {
          "type": "string",
          "description": "Plain English description of the transformation rule"
        },
        "rule_abstract": {
          "type": "string",
          "description": "Formal/symbolic representation of the rule"
        }
      }
    },
    "reasoning": {
      "type": "object",
      "description": "Layer 10-12: Human thought process",
      "properties": {
        "trace": {
          "type": "array",
          "description": "Step-by-step reasoning",
          "items": {
            "type": "object",
            "properties": {
              "step": {"type": "integer"},
              "observation": {"type": "string"},
              "inference": {"type": "string"},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        },
        "hypotheses_considered": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "hypothesis": {"type": "string"},
              "evidence_for": {"type": "array", "items": {"type": "string"}},
              "evidence_against": {"type": "array", "items": {"type": "string"}},
              "accepted": {"type": "boolean"}
            }
          }
        },
        "key_insight": {
          "type": "string",
          "description": "The 'aha' moment that unlocks the puzzle"
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "difficulty": {"type": "string", "enum": ["trivial", "easy", "medium", "hard", "expert"]},
        "cognitive_load": {"type": "integer", "minimum": 1, "maximum": 10},
        "primary_skill": {
          "type": "string",
          "enum": ["pattern_completion", "object_manipulation", "spatial_reasoning", "counting", "color_mapping", "symmetry", "analogy", "rule_induction"]
        },
        "annotator": {"type": "string"},
        "timestamp": {"type": "string", "format": "date-time"}
      }
    }
  }
}
